@@ -0,0 +1,25 @@
+import React from "react";
+
+// Match the optimizer's configured API host. The dashboard makes same-origin
+// requests to /api/backtest inside its frame, avoiding duplicate UI/API logic.
+const API = process.env.REACT_APP_API_URL || "http://localhost:8000/api/optimize";
+const dashboardURL = new URL("/backtest", new URL(API, window.location.origin)).href;
+
+export default function Backtest() {
+  return (
+    <section aria-label="Portfolio backtesting">
+      <p style={{ padding: "0 16px", color: "#617584", fontSize: 14 }}>
+        Historical, out-of-sample comparisons with zero transaction costs. The
+        backend may take a moment to wake up.{" "}
+        <a href={dashboardURL} target="_blank" rel="noopener noreferrer">
+          Open dashboard in a separate tab
+        </a>
+      </p>
+      <iframe
+        title="Portfolio backtest dashboard"
+        src={dashboardURL}
+        style={{ width: "100%", height: "calc(100vh - 125px)", minHeight: 650, border: 0 }}
+      />
+    </section>
+  );
+}
